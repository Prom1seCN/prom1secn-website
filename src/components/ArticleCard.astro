---
import BorderGlow from './BorderGlow';
import { tagStyle } from '../lib/tagStyle';

interface Props {
  slug: string;
  title: string;
  date: string;
  tags: string[];
  basePath?: string; // 文章链接前缀，默认 /blog
}

const { slug, title, date, tags, basePath = '/blog' } = Astro.props;
---

<a href={`${basePath}/${slug}`} style="text-decoration: none; display: block; margin-bottom: 0.75rem;">
  <BorderGlow client:load borderRadius={12} backgroundColor="var(--bg)" glowIntensity={0.4} coneSpread={30}>
    <div style="padding: 1.125rem;">
      <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;">
        <h2 style="margin: 0; font-family:'Noto Sans SC',sans-serif; font-size: 1rem; font-weight: 700; color: var(--text);">{title}</h2>
        <time style="flex-shrink: 0; font-family: ui-monospace, monospace; font-size: 0.6875rem; color: var(--text2);">{date}</time>
      </div>
      {tags.length > 0 && (
        <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.625rem;">
          {tags.map(tag => {
            const c = tagStyle(tag);
            return (
              <span class="tag-badge" style={`border-radius:0.25rem;border:1px solid ${c.border};background:${c.bg};padding:0.1875rem 0.5rem;font-family:ui-monospace,monospace;font-size:0.6875rem;color:${c.text};letter-spacing:0.02em;cursor:default`}>{tag}</span>
            );
          })}
        </div>
      )}
    </div>
  </BorderGlow>
</a>
