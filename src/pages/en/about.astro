---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialIcons from '../../components/SocialIcons';
import ScrollReveal from '../../components/ScrollReveal';
---

<BaseLayout lang="en" title="About">
  <ScrollReveal client:load />

  <section class="hero fade-in-section">
    <h1 class="page-title">About</h1>

    <div style="margin-top: 2rem; max-width: 32rem; line-height: 2.2;">
      <img src="/logo.png" alt="Prom1seCN" style="display: block; width: 260px; height: auto; margin-bottom: 0.75rem;" />
      <p class="hero-tagline" style="font-family:'Noto Sans SC',sans-serif; font-size:1rem; font-weight:700; color:var(--text2); margin-top:0.25rem; margin-bottom:0.5rem;">The meaning of life is maximizing experience</p>
      <p style="font-family: ui-monospace, monospace; font-size: 0.875rem; color: var(--text2);">
        Indie Dev · Content Creator
      </p>

      <div style="margin-top: 1.5rem; font-family: ui-monospace, monospace; font-size: 0.875rem; color: var(--text2); line-height: 2;">
        <p>BUCT · Beijing University of Chemical Technology</p>
        <p>IMIS · Information Management &amp; Information Systems</p>
      </div>
    </div>

    <div style="margin-top: 3rem;">
      <h2 class="section-title" style="margin-bottom: 1rem;">Contact</h2>
      <SocialIcons client:load />
    </div>
  </section>
</BaseLayout>
