---
import { readFileSync, readdirSync, statSync } from 'fs';
import { join, basename } from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BorderGlow from '../../components/BorderGlow';
import ScrollReveal from '../../components/ScrollReveal';
import { parseFrontmatter } from '../../lib/frontmatter';

export const prerender = false;

const NOTES_DIR = process.env.NOTES_DIR || (process.env.USERNAME ? 'D:/note/PROM1SE' : '/note/webdav/data/PROM1SE');
const PROJ_DIR = join(NOTES_DIR, '项目');

const defaultTagColors: Record<string, { bg: string; border: string; text: string }> = {
  'Node.js':         { bg: 'rgba(67,160,71,0.08)',   border: 'rgba(67,160,71,0.25)',   text: '#43a047' },
  'Express':         { bg: 'rgba(158,158,158,0.08)',  border: 'rgba(158,158,158,0.25)',  text: '#9e9e9e' },
  'MongoDB':         { bg: 'rgba(0,150,100,0.08)',    border: 'rgba(0,150,100,0.25)',    text: '#009664' },
  'WeChat Mini Program': { bg: 'rgba(7,193,96,0.08)', border: 'rgba(7,193,96,0.25)',     text: '#07c160' },
  'pm2':             { bg: 'rgba(155,89,182,0.08)',   border: 'rgba(155,89,182,0.25)',   text: '#9b59b6' },
  'Nginx':           { bg: 'rgba(0,150,57,0.08)',     border: 'rgba(0,150,57,0.25)',     text: '#009639' },
  'Astro':           { bg: 'rgba(255,93,1,0.08)',     border: 'rgba(255,93,1,0.25)',     text: '#ff5d01' },
  'React':           { bg: 'rgba(97,218,251,0.08)',   border: 'rgba(97,218,251,0.25)',   text: '#61dafb' },
  'Tailwind':        { bg: 'rgba(56,189,248,0.08)',   border: 'rgba(56,189,248,0.25)',   text: '#38bdf8' },
  'SSR':             { bg: 'rgba(249,115,22,0.08)',   border: 'rgba(249,115,22,0.25)',   text: '#f97316' },
  'KaTeX':           { bg: 'rgba(61,97,161,0.08)',    border: 'rgba(61,97,161,0.25)',    text: '#3d61a1' },
};

const palette = ['#f97316','#22c55e','#3b82f6','#a855f7','#f43f5e','#14b8a6','#eab308','#ec4899'];

function tagStyle(tag: string) {
  if (defaultTagColors[tag]) return defaultTagColors[tag];
  const c = palette[Math.abs(tag.split('').reduce((h,c)=>h*31+c.charCodeAt(0),0)) % palette.length];
  return { bg: c+'10', border: c+'33', text: c };
}

interface Project { title: string; desc: string; tech: string[]; link: string; icon: string; order: number; }

const projects: Project[] = [];

try {
  for (const entry of readdirSync(PROJ_DIR)) {
    if (!entry.endsWith('.md')) continue;
    const full = join(PROJ_DIR, entry);
    const raw = readFileSync(full, 'utf-8');
    const data = parseFrontmatter(raw);
    if (data.publish === true && data.title) {
      const base = basename(entry, '.md');
      const body = raw.split('---').slice(2).join('---').trim();
      const desc = body.split('\n').filter((l: string) => l.trim())[0] || '';
      projects.push({ title: data.title, desc, tech: data.tech || [], link: data.link || '#', icon: `/notes/项目/${base}.png`, order: data.order || 99 });
    }
  }
} catch {}

projects.sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout lang="en" title="Projects">
  <ScrollReveal client:load />

  <section class="hero fade-in-section">
    <h1 class="page-title">Projects</h1>
    <p class="page-desc">Things I build and am building</p>

    {projects.map(p => (
      <a href={p.link} target="_blank" rel="noopener noreferrer" style="text-decoration: none; display: block; margin-top: 1.5rem;">
        <BorderGlow client:load borderRadius={14} backgroundColor="var(--bg)" glowIntensity={0.6} coneSpread={28}>
          <div style="padding: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.875rem;">
              <img src={p.icon} alt={p.title} style="width: 48px; height: 48px; border-radius: 0.625rem; object-fit: cover; flex-shrink: 0; border: 1px solid var(--border);" />
              <div style="flex: 1; min-width: 0;">
                <div style="display: flex; align-items: center; gap: 0.625rem;">
                  <h2 style="margin: 0; font-family:'Noto Sans SC',sans-serif;font-size: 1.125rem; font-weight: 700; color: var(--text);">{p.title}</h2>
                  <span style="border-radius: 9999px; border: 1px solid rgba(249,115,22,0.25); background: rgba(249,115,22,0.06); padding: 0.1875rem 0.5rem; font-family: ui-monospace, monospace; font-size: 0.625rem; color: #f97316; line-height: 1;">live</span>
                </div>
                <p style="margin: 0.375rem 0 0; font-size: 0.875rem; color: var(--text2);">{p.desc}</p>
              </div>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
              {p.tech.map(tag => {
                const c = tagStyle(tag);
                return (
                  <span class="tag-badge" style={`border-radius:0.25rem;border:1px solid ${c.border};background:${c.bg};padding:0.1875rem 0.5rem;font-family:ui-monospace,monospace;font-size:0.6875rem;color:${c.text};letter-spacing:0.02em;cursor:default`}>{tag}</span>
                );
              })}
            </div>
          </div>
        </BorderGlow>
      </a>
    ))}
  </section>

  <style>
    .tag-badge { transition: all 0.2s ease; }
    .tag-badge:hover { transform: translateY(-2px); box-shadow: 0 2px 8px currentColor; opacity: 0.85; }
  </style>
</BaseLayout>
