---
import { readFileSync, readdirSync, statSync } from 'fs';
import { join, basename } from 'path';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;

const NOTES_DIR = process.env.NOTES_DIR || (process.env.USERNAME ? 'D:/note/PROM1SE' : '/note/webdav/data/PROM1SE');
const { slug } = Astro.params;

function parseArticle(raw: string): { data: Record<string, any>; body: string } {
  const parts = raw.split('---');
  if (parts.length < 2) return { data: {}, body: raw };
  const yaml = parts[1];
  let body = parts.slice(2).join('---').trim();
  body = body.replace(/\n{3,}/g, '\n\n<br class="spacer">\n');
  const data: Record<string, any> = {};
  let currentKey = '';
  for (const line of yaml.split('\n')) {
    const trimmed = line.trim();
    if (trimmed.startsWith('- ') && currentKey) {
      if (!Array.isArray(data[currentKey])) data[currentKey] = [];
      data[currentKey].push(trimmed.slice(2).trim());
      continue;
    }
    const i = line.indexOf(':');
    if (i > 0) {
      const key = line.slice(0, i).trim();
      let val: any = line.slice(i + 1).trim();
      if (val.startsWith('[') && val.endsWith(']')) {
        val = val.slice(1, -1).split(',').map((s: string) => s.trim());
      }
      data[key] = val;
      currentKey = key;
    }
  }
  if (data.publish === 'true') data.publish = true;
  if (data.publish === 'false') data.publish = false;
  return { data, body };
}

interface ArticleContent { title: string; date: string; html: string; notFound: boolean; }

const result: ArticleContent = { title: slug || '', date: '', html: '', notFound: true };

function findFile(dir: string): string | null {
  try {
    const entries = readdirSync(dir);
    for (const entry of entries) {
      const full = join(dir, entry);
      try {
        if (statSync(full).isDirectory() && !entry.startsWith('.')) {
          const found = findFile(full);
          if (found) return found;
        } else if (entry.endsWith('.md') && basename(entry, '.md') === slug) {
          return full;
        }
      } catch {}
    }
  } catch {}
  return null;
}

const filePath = findFile(NOTES_DIR);
if (filePath) {
  const raw = readFileSync(filePath, 'utf-8');
  const { data, body } = parseArticle(raw);
  if (data.publish === true) {
    result.title = data.title || slug;
    result.date = data.date || '';
    marked.setOptions({ breaks: true });
    result.html = marked.parse(body);
    result.notFound = false;
  }
}
---

<BaseLayout lang="zh" title={result.title}>
  {result.notFound ? (
    <section style="max-width: 42rem; margin: 0 auto; padding: 4rem 1.5rem; text-align: center;">
      <h1 style="font-size: 4rem; color: #f97316;">404</h1>
      <p style="color: var(--text2);">文章不存在或尚未发布。</p>
      <a href="/blog" style="display: inline-block; margin-top: 1.5rem; color: #f97316; text-decoration: none;">← 返回博客</a>
    </section>
  ) : (
    <article style="max-width: 42rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; color: var(--text2);">
      <time style="font-family: ui-monospace, monospace; font-size: 0.75rem; color: var(--text2);">{result.date}</time>
      <h1 style="font-family: ui-monospace, monospace; font-size: 1.5rem; font-weight: 500; color: var(--text); margin-top: 0.5rem; letter-spacing: -0.02em;">{result.title}</h1>

      <style>
        .article-body { font-size: 0.875rem; line-height: 1.85; color: var(--text2); }
        .article-body p { margin-bottom: 1.25rem; }
        .article-body br.spacer { content: ''; display: block; margin: 1rem 0; }
      </style>
      <div class="article-body" style="margin-top: 2rem;" set:html={result.html} />

      <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" crossorigin="anonymous"></script>
      <script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" crossorigin="anonymous"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          renderMathInElement(document.querySelector('.article-body'), {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
            ],
          });
        });
      </script>
    </article>
  )}
</BaseLayout>
