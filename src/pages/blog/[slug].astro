---
import { readFileSync, readdirSync, statSync } from 'fs';
import { join, basename } from 'path';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseFrontmatter } from '../../lib/frontmatter';

export const prerender = false;

const NOTES_DIR = process.env.NOTES_DIR || (process.env.USERNAME ? 'D:/note/PROM1SE' : '/note/webdav/data/PROM1SE');
const { slug } = Astro.params;

interface ArticleContent { title: string; date: string; html: string; notFound: boolean; }

const result: ArticleContent = { title: slug || '', date: '', html: '', notFound: true };

function findFile(dir: string): string | null {
  try {
    const entries = readdirSync(dir);
    for (const entry of entries) {
      const full = join(dir, entry);
      try {
        if (statSync(full).isDirectory() && !entry.startsWith('.')) {
          const found = findFile(full);
          if (found) return found;
        } else if (entry.endsWith('.md') && basename(entry, '.md') === slug) {
          return full;
        }
      } catch {}
    }
  } catch {}
  return null;
}

const filePath = findFile(NOTES_DIR);
if (filePath) {
  const raw = readFileSync(filePath, 'utf-8');
  const data = parseFrontmatter(raw);
  if (data.publish === true) {
    let body = raw.split('---').slice(2).join('---').trim();
    body = body.replace(/\n{3,}/g, '\n\n<br class="spacer">\n');
    // Obsidian 双链 → 站内链接：[[文件名]] / [[文件名|别名]] / [[文件名#标题]]
    // 目标统一取文件名（站点按 basename 全局查找，[[项目/百花同行]] → /blog/百花同行）
    body = body.replace(/\[\[([^\]]+)\]\]/g, (_m: string, inner: string) => {
      const [rawTarget, alias] = inner.split('|');
      const target = rawTarget.split('#')[0].trim().replace(/\.md$/, '').split('/').pop() || '';
      if (!target) return inner;
      const label = (alias || rawTarget).split('#')[0].trim().split('/').pop() || target;
      return `[${label}](/blog/${target})`;
    });
    result.title = data.title || slug;
    result.date = data.date || '';
    marked.setOptions({ breaks: true });
    result.html = marked.parse(body);
    result.notFound = false;
  }
}
---

<BaseLayout lang="zh" title={result.title}>
  {result.notFound ? (
    <section style="max-width: 42rem; margin: 0 auto; padding: 4rem 1.5rem; text-align: center;">
      <h1 style="font-size: 4rem; color: #f97316;">404</h1>
      <p style="color: var(--text2);">文章不存在或尚未发布。</p>
      <a href="/blog" style="display: inline-block; margin-top: 1.5rem; color: #f97316; text-decoration: none;">← 返回博客</a>
    </section>
  ) : (
    <article style="max-width: 42rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; color: var(--text2);">
      <time style="font-family: ui-monospace, monospace; font-size: 0.75rem; color: var(--text2);">{result.date}</time>
      <h1 style="font-family: ui-monospace, monospace; font-size: 1.5rem; font-weight: 500; color: var(--text); margin-top: 0.5rem; letter-spacing: -0.02em;">{result.title}</h1>

      <style>
        .article-body { font-size: 0.875rem; line-height: 1.85; color: var(--text2); }
        .article-body p { margin-bottom: 1.25rem; }
        .article-body br.spacer { content: ''; display: block; margin: 1rem 0; }

        /* 标题（Tailwind preflight 会重置，这里按 Obsidian 层级补回） */
        .article-body h1 { font-size: 1.6rem; font-weight: 700; color: var(--text); margin: 2.25rem 0 0.75rem; letter-spacing: -0.01em; line-height: 1.4; }
        .article-body h2 { font-size: 1.35rem; font-weight: 700; color: var(--text); margin: 2rem 0 0.75rem; line-height: 1.4; }
        .article-body h3 { font-size: 1.125rem; font-weight: 700; color: var(--text); margin: 1.6rem 0 0.5rem; line-height: 1.4; }
        .article-body h4, .article-body h5, .article-body h6 { font-size: 1rem; font-weight: 700; color: var(--text); margin: 1.4rem 0 0.5rem; }

        /* 链接：橙色下划线（含 Obsidian 双链转换后的站内链接） */
        .article-body a { color: #f97316; text-decoration: underline; text-decoration-color: rgba(249,115,22,0.4); text-underline-offset: 3px; transition: text-decoration-color 0.2s, color 0.2s; }
        .article-body a:hover { text-decoration-color: #f97316; }

        /* 列表 */
        .article-body ul { list-style: disc; padding-left: 1.5rem; margin: 0 0 1.25rem; }
        .article-body ol { list-style: decimal; padding-left: 1.5rem; margin: 0 0 1.25rem; }
        .article-body li { margin: 0.25rem 0; }

        /* 行内代码 / 代码块 */
        .article-body code { font-family: ui-monospace, monospace; font-size: 0.8125rem; background: rgba(249,115,22,0.07); border: 1px solid rgba(249,115,22,0.18); border-radius: 0.25rem; padding: 0.08rem 0.35rem; color: var(--text); }
        .article-body pre { background: rgba(0,0,0,0.25); border: 1px solid var(--border); border-radius: 0.5rem; padding: 1rem 1.125rem; overflow-x: auto; margin: 0 0 1.25rem; }
        .article-body pre code { background: none; border: none; padding: 0; color: var(--text2); font-size: 0.8125rem; }

        /* 引用 / 分割线 / 图片 / 强调 */
        .article-body blockquote { border-left: 3px solid #f97316; padding: 0.15rem 0 0.15rem 1rem; margin: 0 0 1.25rem; color: var(--text2); }
        .article-body blockquote p { margin-bottom: 0.5rem; }
        .article-body hr { border: none; border-top: 1px solid var(--border); margin: 2.25rem 0; }
        .article-body img { max-width: 100%; border-radius: 0.5rem; margin: 0.5rem 0; }
        .article-body strong { color: var(--text); font-weight: 700; }

        /* 表格 */
        .article-body table { width: 100%; border-collapse: collapse; margin: 0 0 1.25rem; font-size: 0.8125rem; }
        .article-body th, .article-body td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
        .article-body th { color: var(--text); font-weight: 700; background: rgba(249,115,22,0.05); }
      </style>
      <div class="article-body" style="margin-top: 2rem;" set:html={result.html} />

      <script is:inline src="/katex/katex.min.js"></script>
      <script is:inline src="/katex/contrib/auto-render.min.js"></script>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          renderMathInElement(document.querySelector('.article-body'), {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
            ],
          });
        });
      </script>
    </article>
  )}
</BaseLayout>
