---
import { readFileSync, readdirSync, statSync } from 'fs';
import { join, basename } from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal';
import { parseFrontmatter } from '../lib/frontmatter';

export const prerender = false;

const NOTES_DIR = process.env.NOTES_DIR || (process.env.USERNAME ? 'D:/note/PROM1SE' : '/note/webdav/data/PROM1SE');

interface Article { slug: string; title: string; date: string; }

const articles: Article[] = [];

function walkDir(dir: string) {
  try {
    for (const entry of readdirSync(dir)) {
      const full = join(dir, entry);
      try {
        if (statSync(full).isDirectory() && !entry.startsWith('.')) {
          walkDir(full);
        } else if (entry.endsWith('.md')) {
          const data = parseFrontmatter(readFileSync(full, 'utf-8'));
          if (data.publish === true && data.title && data.date) {
            articles.push({
              slug: basename(entry, '.md'),
              title: data.title,
              date: data.date,
            });
          }
        }
      } catch {}
    }
  } catch {}
}

walkDir(NOTES_DIR);
articles.sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout lang="zh" title="博客">
  <ScrollReveal client:load />
  <section class="hero fade-in-section">
    <h1 class="page-title">博客</h1>
    <p class="page-desc">生活中的记录与思考</p>

    <div style="margin-top: 2rem;">
      {articles.length === 0 && (
        <div class="empty-state"><p>还没有文章。</p></div>
      )}
      {articles.map((a) => (
        <a href={`/blog/${a.slug}`} style="text-decoration: none; display: block; border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.125rem; margin-bottom: 0.75rem; transition: border-color 0.2s, box-shadow 0.3s;" onmouseover="this.style.borderColor='#f97316'; this.style.boxShadow='0 2px 16px rgba(249,115,22,0.08)'" onmouseout="this.style.borderColor='var(--border)'; this.style.boxShadow='none'">
          <time style="font-family: ui-monospace, monospace; font-size: 0.6875rem; color: var(--text2);">{a.date}</time>
          <h2 style="margin-top: 0.375rem; font-family:'Noto Sans SC',sans-serif; font-size: 1rem; font-weight: 700; color: var(--text);">{a.title}</h2>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
