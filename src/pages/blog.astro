---
import { readFileSync, readdirSync, statSync } from 'fs';
import { join, basename } from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import BorderGlow from '../components/BorderGlow';
import ScrollReveal from '../components/ScrollReveal';
import { parseFrontmatter } from '../lib/frontmatter';
import { tagStyle } from '../lib/tagStyle';

export const prerender = false;

const NOTES_DIR = process.env.NOTES_DIR || (process.env.USERNAME ? 'D:/note/PROM1SE' : '/note/webdav/data/PROM1SE');

interface Article { slug: string; title: string; date: string; tags: string[]; }

const articles: Article[] = [];

function walkDir(dir: string) {
  try {
    for (const entry of readdirSync(dir)) {
      const full = join(dir, entry);
      try {
        if (statSync(full).isDirectory() && !entry.startsWith('.')) {
          walkDir(full);
        } else if (entry.endsWith('.md')) {
          const data = parseFrontmatter(readFileSync(full, 'utf-8'));
          if (data.publish === true && data.title && data.date) {
            articles.push({
              slug: basename(entry, '.md'),
              title: data.title,
              date: data.date,
              tags: data.tags || [],
            });
          }
        }
      } catch {}
    }
  } catch {}
}

walkDir(NOTES_DIR);
articles.sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout lang="zh" title="博客">
  <ScrollReveal client:load />
  <section class="hero fade-in-section">
    <h1 class="page-title">博客</h1>
    <p class="page-desc">生活中的记录与思考</p>

    <div style="margin-top: 2rem;">
      {articles.length === 0 && (
        <div class="empty-state"><p>还没有文章。</p></div>
      )}
      {articles.map((a) => (
        <a href={`/blog/${a.slug}`} style="text-decoration: none; display: block; margin-bottom: 0.75rem;">
          <BorderGlow client:load borderRadius={12} backgroundColor="var(--bg)" glowIntensity={0.4} coneSpread={30}>
            <div style="padding: 1.125rem;">
              <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;">
                <h2 style="margin: 0; font-family:'Noto Sans SC',sans-serif; font-size: 1rem; font-weight: 700; color: var(--text);">{a.title}</h2>
                <time style="flex-shrink: 0; font-family: ui-monospace, monospace; font-size: 0.6875rem; color: var(--text2);">{a.date}</time>
              </div>
              {a.tags.length > 0 && (
                <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.625rem;">
                  {a.tags.map(tag => {
                    const c = tagStyle(tag);
                    return (
                      <span class="tag-badge" style={`border-radius:0.25rem;border:1px solid ${c.border};background:${c.bg};padding:0.1875rem 0.5rem;font-family:ui-monospace,monospace;font-size:0.6875rem;color:${c.text};letter-spacing:0.02em;cursor:default`}>{tag}</span>
                    );
                  })}
                </div>
              )}
            </div>
          </BorderGlow>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
