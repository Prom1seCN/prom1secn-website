---
import { readFileSync, readdirSync, statSync } from 'fs';
import { join, basename } from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

const NOTES_DIR = process.env.NOTES_DIR || (process.env.USERNAME ? 'D:/note/PROM1SE' : '/note/webdav/data/PROM1SE');
const query = (Astro.url.searchParams.get('q') || '').trim().toLowerCase();

interface Result { title: string; url: string; type: 'blog' | 'project'; }

const results: Result[] = [];

// Search projects
const projects = [
  { title: '百花同行', url: '/projects' },
];
for (const p of projects) {
  if (p.title.toLowerCase().includes(query) || '拼车 小程序 BUCT'.toLowerCase().includes(query)) {
    results.push({ title: p.title, url: p.url, type: 'project' });
  }
}

// Search blog
function parseFrontmatter(raw: string): Record<string, any> {
  const parts = raw.split('---');
  if (parts.length < 2) return {};
  const data: Record<string, any> = {};
  for (const line of parts[1].split('\n')) {
    const i = line.indexOf(':');
    if (i > 0) data[line.slice(0, i).trim()] = line.slice(i + 1).trim();
  }
  if (data.publish === 'true') data.publish = true;
  return data;
}

function walkDir(dir: string) {
  try {
    for (const entry of readdirSync(dir)) {
      const full = join(dir, entry);
      try {
        if (statSync(full).isDirectory() && !entry.startsWith('.')) walkDir(full);
        else if (entry.endsWith('.md')) {
          const data = parseFrontmatter(readFileSync(full, 'utf-8'));
          if (data.publish === true && data.title) {
            const raw = readFileSync(full, 'utf-8');
            const body = raw.split('---').slice(2).join('---').toLowerCase();
            if (data.title.toLowerCase().includes(query) || body.includes(query)) {
              results.push({
                title: data.title,
                url: `/blog/${basename(entry, '.md')}`,
                type: 'blog',
              });
            }
          }
        }
      } catch {}
    }
  } catch {}
}

if (query) walkDir(NOTES_DIR);
---

<BaseLayout lang="zh" title={`搜索：${query}`}>
  <section style="max-width: 42rem; margin: 0 auto; padding: 2rem 1.5rem 4rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text2);">
        <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <input
        id="search-input"
        type="text"
        value={query}
        placeholder="搜索博客和项目..."
        autofocus
        style="flex:1;background:transparent;border:none;outline:none;font-size:1.125rem;font-family:inherit;color:var(--text);"
      />
    </div>

    <script>
      document.getElementById('search-input')!.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter') {
          const q = e.target.value.trim();
          if (q) window.location.href = '/search?q=' + encodeURIComponent(q);
        }
      });
    </script>

    {!query ? (
      <p style="color: var(--text2);">输入关键词搜索博客和项目。</p>
    ) : results.length === 0 ? (
      <p style="color: var(--text2); font-size: 0.875rem;">没有找到「{query}」相关的内容。</p>
    ) : (
      <>
        <p style="color: var(--text2); font-size: 0.75rem; font-family: ui-monospace, monospace; margin-bottom: 1rem;">
          {results.length} 个结果
        </p>
        {results.map((r) => (
          <a href={r.url} style="text-decoration: none; display: block; border: 1px solid var(--border); border-radius: 0.75rem; padding: 1rem 1.125rem; margin-bottom: 0.5rem; transition: border-color 0.2s, box-shadow 0.3s;" onmouseover="this.style.borderColor='#f97316'; this.style.boxShadow='0 2px 12px rgba(249,115,22,0.06)'" onmouseout="this.style.borderColor='var(--border)'; this.style.boxShadow='none'">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
              <span style={`border-radius:0.25rem;padding:0.125rem 0.375rem;font-family:ui-monospace,monospace;font-size:0.5625rem;border:1px solid ${r.type === 'project' ? 'rgba(249,115,22,0.3)' : 'var(--border)'};color:${r.type === 'project' ? '#f97316' : 'var(--text2)'}`}>{r.type === 'project' ? '项目' : '博客'}</span>
              <span style="font-weight: 500; font-size: 0.9375rem; color: var(--text);">{r.title}</span>
            </div>
          </a>
        ))}
      </>
    )}
  </section>
</BaseLayout>
