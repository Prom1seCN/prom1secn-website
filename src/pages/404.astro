---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="zh" title="404">
  <section class="hero fade-in-section" style="text-align: center; padding-top: 6rem;">
    <h1 style="font-family: ui-monospace, monospace; font-size: 6rem; font-weight: 500; color: #f97316; line-height: 1;">
      404
    </h1>
    <p style="margin-top: 1rem; font-size: 1.125rem; color: var(--text2);">
      这个页面不存在，或者还没构建。
    </p>
    <p style="margin-top: 0.5rem; font-family: ui-monospace, monospace; font-size: 0.75rem; color: var(--text2);">
      ?
    </p>
    <a href="/" style="display: inline-block; margin-top: 2rem; font-family: ui-monospace, monospace; font-size: 0.875rem; color: #f97316; text-decoration: none; border: 1px solid #f97316; padding: 0.5rem 1.5rem; border-radius: 8px; transition: all 0.2s;">
      ← 回首页
    </a>
  </section>
</BaseLayout>
